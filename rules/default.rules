prefix_rule(pattern=["npx", "tsc", "-b", "--noEmit"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "Get-Item -LiteralPath D:\\code\\tacti-sense\\five-finger\\可删除.md | Select-Object FullName,Length,LastWriteTime"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$files = @('vite.config.mts','tailwind.config.mts','postcss.config.mjs','components.json','tsconfig.json','tsconfig.app.json','tsconfig.node.json','eslint.config.mjs'); foreach ($file in $files) { \"$file root=$((Test-Path $file)) web=$((Test-Path (Join-Path 'web' $file)))\" }"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "Get-ChildItem -Path 'D:\\code' -Recurse -File -Filter '*SignalR*' -ErrorAction SilentlyContinue | Select-Object -First 80 FullName,Length,LastWriteTime"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "Get-ChildItem -LiteralPath 'C:\\Users\\Administrator\\Desktop' -Force -ErrorAction SilentlyContinue | Select-Object Name,FullName,Length,LastWriteTime"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "Get-ChildItem -Path 'C:\\Users\\Administrator' -Recurse -File -Filter '*SignalR*' -ErrorAction SilentlyContinue | Select-Object -First 80 FullName,Length,LastWriteTime"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
